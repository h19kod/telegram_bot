# Copy to .env and fill in. NEVER commit .env. See docs/ENVIRONMENT.md for every variable.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
DATABASE_URL=postgres://sop:CHANGE_ME@localhost:5432/sop
REDIS_URL=redis://localhost:6379/0
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=
PLATFORM_ADMIN_REQUIRE_2FA=true

# --- Telegram ---
# Empty in development → bots run in polling mode.
TELEGRAM_WEBHOOK_BASE_URL=
MINI_APP_BASE_URL=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# --- Bot service ---
BOT_MODE=polling
BACKEND_INTERNAL_URL=http://localhost:8000
BOT_REDIS_URL=redis://localhost:6379/1

# --- Storage (S3 / MinIO) ---
USE_S3=false
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_CUSTOM_DOMAIN=

# --- AI assistant (optional) ---
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-5-5
AI_API_KEY=

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
DASHBOARD_BASE_URL=http://localhost:5174

# --- Monitoring ---
SENTRY_DSN=
LOG_FORMAT=json
